 "narration": [
  {
   "id": "n1",
   "start": 2.4,
   "hold": 3,
   "text": "It began with a question."
  },
  {
   "id": "n2",
   "start": 6.754545454545454,
   "hold": 2.3,
   "text": "What is true?"
  },
  {
   "id": "n3",
   "start": 10.9,
   "hold": 2.2,
   "text": "What is good?"
  },
  {
   "id": "n4",
   "start": 19.08181818181818,
   "hold": 2.3,
   "text": "What is just?"
  },
  {
   "id": "n5",
   "start": 49.872727272727275,
   "hold": 5.1,
   "text": "From those questions came reason, law, art, and science."
  },
  {
   "id": "n6",
   "start": 92.57535885167465,
   "hold": 3.8,
   "text": "A deaf man wrote a symphony of joy."
  },
  {
   "id": "n7",
   "start": 121.62535885167465,
   "hold": 5.5,
   "text": "Ideas once carried by ship now cross the world in an instant,"
  },
  {
   "id": "n8",
   "start": 130.52535885167464,
   "hold": 4.5,
   "text": "and progress that took centuries now takes years."
  },
  {
   "id": "n9",
   "start": 152.07081339712917,
   "hold": 4.6,
   "text": "Now we’re building minds to think alongside our own."
  },
  {
   "id": "n10",
   "start": 172.07081339712917,
   "hold": 2.9,
   "text": "The story isn’t finished."
  },
  {
   "id": "n11",
   "start": 177.2708133971292,
   "hold": 3,
   "text": "It’s yours to continue."
  }
 ]
